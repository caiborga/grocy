# Copy to .env and replace every CHANGE_ME. Never commit .env.

# PORT
# HTTP-Port der Anwendung. In Docker typischerweise 8080.
PORT=8080

# SPRING_PROFILES_ACTIVE
# Lokal: local   |   Produktion: prod
SPRING_PROFILES_ACTIVE=local

# SPRING_DATASOURCE_URL
# Lokal typisch: jdbc:postgresql://localhost:3300/grocy
SPRING_DATASOURCE_URL=jdbc:postgresql://HOST:5432/DATABASE

# SPRING_DATASOURCE_USERNAME
SPRING_DATASOURCE_USERNAME=CHANGE_ME

# SPRING_DATASOURCE_PASSWORD
# Wird auch von docker-compose.example.yml für Postgres gelesen.
SPRING_DATASOURCE_PASSWORD=CHANGE_ME

# JWT_SECRET
# Mindestens 32 Byte zufälliger Wert. Kein Default in der Anwendung.
JWT_SECRET=CHANGE_ME_USE_A_LONG_RANDOM_SECRET

# JWT_EXPIRATION_MS
# Optionale Tokenlebensdauer in Millisekunden. Default: 7 Tage.
# JWT_EXPIRATION_MS=604800000

# APP_FRONTEND_URL
# Öffentliche Basis-URL für Links in E-Mails und Einladungen.
APP_FRONTEND_URL=https://example.invalid

# APP_MAIL_FROM
APP_MAIL_FROM=noreply@example.invalid

# APP_MAIL_ENABLED
APP_MAIL_ENABLED=false

# SMTP_HOST
SMTP_HOST=smtp.example.invalid

# SMTP_PORT
SMTP_PORT=587

# SMTP_USERNAME
SMTP_USERNAME=CHANGE_ME

# SMTP_PASSWORD
SMTP_PASSWORD=CHANGE_ME

# APP_REGISTRATION_ENABLED
# In Produktion false lassen, bis bewusst aktiviert.
APP_REGISTRATION_ENABLED=false

# APP_ADMIN_EMAILS
# Kommagetrennte E-Mail-Adressen der zentralen Administratorrolle.
APP_ADMIN_EMAILS=

# APP_RATE_LIMIT_ENABLED
APP_RATE_LIMIT_ENABLED=true

# SPRINGDOC_ENABLED
# OpenAPI/Swagger nur lokal bei Bedarf aktivieren.
SPRINGDOC_ENABLED=false

# JAVA_OPTS
# JAVA_OPTS=-Xms256m -Xmx512m
